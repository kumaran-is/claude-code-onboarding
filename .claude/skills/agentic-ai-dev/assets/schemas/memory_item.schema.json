{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryItem",
  "description": "One durable agent-memory record (MEM §4; home: agentic-ai-dev/reference/agent-memory-lifecycle.md §3, §14). Working/session memory is not durable and has no MemoryItem. Cross-field rules (writer policy, provenance, claims, prohibited data, status consistency) live in scripts/validate_memory_item.py.",
  "type": "object",
  "required": [
    "item_id", "memory_type", "org_id", "subject_type", "subject_id", "role_visibility", "consequential",
    "content", "source_refs", "source_versions", "canonical_version", "provenance_quality", "written_by",
    "schema_version", "created_at", "generated_at", "expires_at", "freshness_state", "status"
  ],
  "additionalProperties": false,
  "properties": {
    "item_id": {"type": "string", "minLength": 1},
    "memory_type": {
      "description": "Durable types from §3. Each supported type needs its written definition (agent-memory-lifecycle.md §2).",
      "enum": ["conversation_history", "long_term_user_entity", "compiled_knowledge", "episodic_outcome", "shared_org_knowledge"]
    },
    "org_id": {"description": "Isolation root (§7). An item without org_id is invalid.", "type": "string", "minLength": 1},
    "subject_type": {"enum": ["user", "entity", "aggregate"]},
    "subject_id": {"type": "string", "minLength": 1},
    "role_visibility": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "consequential": {"description": "True when the item's memory type is declared consequential (feeds decisions, briefings or aggregates).", "type": "boolean"},
    "content": {"description": "Human-readable content. Empty only when status is DELETED (tombstone).", "type": "string"},
    "structured_facts": {"type": "object"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "source_refs": {"description": "Canonical record / document IDs. Lineage is the erasure index (§9).", "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_versions": {"description": "Version of each source_refs entry at compile time, same order and length.", "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_event_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "canonical_version": {"type": "integer", "minimum": 0},
    "provenance_quality": {"enum": ["RECORDED_LIVE", "USER_STATED", "MIGRATED_STRUCTURED", "MIGRATED_PARTIAL", "RECONSTRUCTED", "MODEL_INFERRED", "UNKNOWN_PROVENANCE"]},
    "confidence": {"description": "Evidence quality, not model self-confidence.", "type": "number", "minimum": 0, "maximum": 1},
    "written_by": {"$ref": "#/$defs/writer"},
    "compiler_version": {"type": "string", "minLength": 1},
    "model_name": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "expires_at": {"description": "Nothing is keep-forever by default (§9).", "type": "string", "format": "date-time"},
    "freshness_state": {"enum": ["FRESH", "AGING", "STALE", "UNKNOWN"]},
    "status": {"enum": ["CURRENT", "STALE", "SUPERSEDED", "CONFLICTED", "REBUILD_REQUIRED", "REVIEW_REQUIRED", "DELETED"]},
    "legal_hold": {"description": "Overrides expiry for this item; recorded and audited (§9).", "type": "boolean"}
  },
  "$defs": {
    "writer": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "Writer matrix §5.1. Untrusted kinds are listed so the validator can reject them with UNTRUSTED_WRITER.",
          "enum": ["compiler", "agent_runtime", "user_self", "curator",
                   "tool_output", "retrieved_document", "inbound_message", "upload", "web"]
        },
        "id": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "claim_text", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "claim_text": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_versions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["CURRENT", "REVIEW_REQUIRED"]}
      }
    },
    "file": {
      "description": "File shape: one MemoryItem object, or this wrapper.",
      "type": "object",
      "required": ["memory_items"],
      "additionalProperties": false,
      "properties": {
        "memory_items": {"type": "array", "minItems": 1},
        "example": {"description": "true marks fictional example data; rejected unless --allow-examples.", "type": "boolean"}
      }
    }
  }
}
