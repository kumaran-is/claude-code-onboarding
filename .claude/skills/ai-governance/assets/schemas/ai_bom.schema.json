{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI bill of materials",
  "description": "AI BOM with integrity, provenance, lineage and release-blocking fields. Source: ai-governance skill, governance sections 2.5, 9.1, 9.2, 9.3. Boundary A (validator checks completeness/pinning/digests) / C (registries, attestations, independent validation). Structural and consistency validation only: a valid record proves neither that a control works nor that anyone adopted or approved it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "record_status",
    "bom_id",
    "system_id",
    "generated_at",
    "system_profile",
    "components",
    "vulnerability_scan_ref",
    "deployment_manifest_ref",
    "exceptions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "record_type": {
      "const": "ai_bom"
    },
    "schema_version": {
      "const": "1.0"
    },
    "record_status": {
      "enum": [
        "draft",
        "final",
        "example"
      ],
      "description": "'example' records are rejected unless --allow-examples is passed."
    },
    "bom_id": {
      "type": "string",
      "minLength": 3
    },
    "system_id": {
      "type": "string",
      "minLength": 3
    },
    "generated_at": {
      "$ref": "#/$defs/datetime"
    },
    "system_profile": {
      "type": "object",
      "required": [
        "fine_tunes",
        "durable_memory"
      ],
      "additionalProperties": false,
      "properties": {
        "fine_tunes": {
          "type": "boolean"
        },
        "durable_memory": {
          "type": "boolean"
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_type",
          "name",
          "version",
          "license",
          "provenance"
        ],
        "properties": {
          "component_type": {
            "enum": [
              "foundation_model",
              "model_weights",
              "adapter",
              "tokenizer",
              "prompt_template",
              "embedding_model",
              "training_dataset",
              "evaluation_dataset",
              "judge_model",
              "retrieval_dependency",
              "mcp_server",
              "tool_package",
              "container_image",
              "software_library"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "Pinned version; ranges, wildcards and 'latest' are rejected."
          },
          "provider": {
            "type": "string",
            "minLength": 3
          },
          "vendor_model_id": {
            "type": "string",
            "minLength": 3
          },
          "region": {
            "type": "string",
            "minLength": 3
          },
          "digest": {
            "type": "object",
            "required": [
              "algorithm",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "algorithm": {
                "enum": [
                  "sha256",
                  "sha384",
                  "sha512"
                ]
              },
              "value": {
                "type": "string",
                "pattern": "^[a-f0-9]{64,128}$"
              }
            }
          },
          "license": {
            "type": "string",
            "minLength": 3
          },
          "usage_rights": {
            "type": "string",
            "minLength": 3
          },
          "provenance": {
            "type": "object",
            "required": [
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 3
              },
              "registry": {
                "type": "string",
                "minLength": 3
              },
              "attestation_ref": {
                "$ref": "#/$defs/ref"
              }
            }
          },
          "visibility_limitations": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_lineage_ref": {
          "$ref": "#/$defs/ref"
        },
        "memory_lineage_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_to_derived_map_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "deletion_propagation_tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "vulnerability_scan_ref": {
      "$ref": "#/$defs/ref"
    },
    "deployment_manifest_ref": {
      "$ref": "#/$defs/ref"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "description": "A named individual and their governance role. Placeholders are rejected by the validator.",
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "role": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ref": {
      "type": "string",
      "minLength": 3,
      "description": "Evidence location: repo path, URL or record id."
    },
    "exception": {
      "type": "object",
      "description": "Authorized, time-bound risk acceptance or waiver.",
      "required": [
        "waiver_id",
        "approved_by",
        "expires",
        "risk_accepted"
      ],
      "additionalProperties": false,
      "properties": {
        "waiver_id": {
          "type": "string",
          "minLength": 3
        },
        "approved_by": {
          "$ref": "#/$defs/person"
        },
        "expires": {
          "$ref": "#/$defs/date"
        },
        "risk_accepted": {
          "type": "string",
          "minLength": 3
        }
      }
    }
  }
}
