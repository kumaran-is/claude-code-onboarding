{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human approval of one proposed consequential action",
  "description": "Evidence that a specific proposed action was shown with the required context and decided by a named human before expiry. Source: ai-governance skill, governance sections 4.1(6), 5.3, 7.1, 7.2, 7.3. Boundary A (validator checks binding/expiry/timeout) / C (approval UX and operations). Structural and consistency validation only: a valid record proves neither that a control works nor that anyone adopted or approved it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "record_status",
    "approval_id",
    "system_id",
    "operation_id",
    "proposed_action",
    "action_digest",
    "authoritative_state",
    "source_evidence",
    "uncertainty",
    "policy_warnings",
    "requested_at",
    "expires_at",
    "timeout_policy",
    "decision",
    "bulk"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "record_type": {
      "const": "approval_record"
    },
    "schema_version": {
      "const": "1.0"
    },
    "record_status": {
      "enum": [
        "draft",
        "final",
        "example"
      ],
      "description": "'example' records are rejected unless --allow-examples is passed."
    },
    "approval_id": {
      "type": "string",
      "minLength": 3
    },
    "system_id": {
      "type": "string",
      "minLength": 3
    },
    "operation_id": {
      "type": "string",
      "minLength": 3
    },
    "proposed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "action_type",
        "resource_id",
        "impact",
        "side_effects",
        "reversibility",
        "alternatives"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 3
        },
        "action_type": {
          "type": "string",
          "minLength": 3
        },
        "resource_id": {
          "type": "string",
          "minLength": 3
        },
        "impact": {
          "type": "string",
          "minLength": 3
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "reversibility": {
          "enum": [
            "reversible",
            "compensatable",
            "irreversible"
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "action_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "sha256 of the canonical proposed action; binds the approval to that exact action."
    },
    "authoritative_state": {
      "type": "object",
      "required": [
        "source",
        "version",
        "read_at"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "read_at": {
          "$ref": "#/$defs/datetime"
        }
      }
    },
    "source_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "minItems": 1
    },
    "uncertainty": {
      "type": "string",
      "minLength": 3
    },
    "policy_warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "requested_at": {
      "$ref": "#/$defs/datetime"
    },
    "expires_at": {
      "$ref": "#/$defs/datetime"
    },
    "timeout_policy": {
      "enum": [
        "hold",
        "reject",
        "safe_degrade"
      ],
      "description": "Never auto-approve (section 7.3)."
    },
    "decision": {
      "enum": [
        "approve",
        "reject",
        "modify",
        "request_evidence",
        "escalate",
        "defer",
        "timed_out"
      ]
    },
    "decided_by": {
      "$ref": "#/$defs/person"
    },
    "decided_at": {
      "$ref": "#/$defs/datetime"
    },
    "risk_acknowledged": {
      "type": "boolean"
    },
    "modified_action_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timeout_outcome": {
      "enum": [
        "hold",
        "reject",
        "safe_degrade"
      ]
    },
    "bulk": {
      "type": "boolean"
    },
    "bulk_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation_id",
          "action_digest"
        ],
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 3
          },
          "action_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "description": "A named individual and their governance role. Placeholders are rejected by the validator.",
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "role": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ref": {
      "type": "string",
      "minLength": 3,
      "description": "Evidence location: repo path, URL or record id."
    }
  }
}
