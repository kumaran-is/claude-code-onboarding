{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Control test evidence record",
  "description": "One execution of a control test, including forced unsafe release scenarios. Source: ai-governance skill, governance sections 1.3, 10.5, 16.1. Boundary A (toolkit tests can emit it) / C (evidence repository and retention). Structural and consistency validation only: a valid record proves neither that a control works nor that anyone adopted or approved it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "record_status",
    "evidence_id",
    "control_id",
    "executed_at",
    "executed_by",
    "environment",
    "method",
    "expected_outcome",
    "observed_outcome",
    "control_decision",
    "artifact_refs",
    "negative_control",
    "result",
    "mocked"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "record_type": {
      "const": "control_evidence"
    },
    "schema_version": {
      "const": "1.0"
    },
    "record_status": {
      "enum": [
        "draft",
        "final",
        "example"
      ],
      "description": "'example' records are rejected unless --allow-examples is passed."
    },
    "evidence_id": {
      "type": "string",
      "minLength": 3
    },
    "control_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z][A-Z0-9]*)*-[0-9]{3}$"
    },
    "executed_at": {
      "$ref": "#/$defs/datetime"
    },
    "executed_by": {
      "type": "string",
      "minLength": 3
    },
    "environment": {
      "enum": [
        "sandbox",
        "ci",
        "staging",
        "production"
      ]
    },
    "method": {
      "enum": [
        "automated_test",
        "seeded_unsafe_scenario",
        "failure_injection",
        "manual_review",
        "audit_sample"
      ]
    },
    "scenario": {
      "enum": [
        "known_bad_model_output",
        "unauthorized_tool_access",
        "cross_tenant_retrieval",
        "stale_human_approval",
        "prohibited_sensitive_data_transfer",
        "duplicate_financial_mutation",
        "prompt_injection_in_retrieved_content",
        "invalid_artifact_manifest"
      ]
    },
    "command": {
      "type": "string",
      "minLength": 3
    },
    "exit_code": {
      "type": "integer"
    },
    "expected_outcome": {
      "enum": [
        "blocked",
        "quarantined",
        "contained",
        "allowed"
      ]
    },
    "observed_outcome": {
      "enum": [
        "blocked",
        "quarantined",
        "contained",
        "allowed",
        "not_observed"
      ]
    },
    "control_decision": {
      "type": "string",
      "minLength": 3
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "minItems": 1
    },
    "negative_control": {
      "type": "object",
      "required": [
        "performed"
      ],
      "additionalProperties": false,
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 3
        },
        "observed_failure": {
          "type": "boolean"
        }
      }
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "not_run"
      ]
    },
    "mocked": {
      "type": "boolean",
      "description": "True when the test used fakes or fixture models; mocked evidence is never live-provider validation."
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "description": "A named individual and their governance role. Placeholders are rejected by the validator.",
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "role": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ref": {
      "type": "string",
      "minLength": 3,
      "description": "Evidence location: repo path, URL or record id."
    }
  }
}
