{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Control effectiveness register entry",
  "description": "One row of the living control effectiveness register. Source: ai-governance skill, governance sections 1.2, 1.3, 16.1, 16.2. Boundary B (template) / C (named owners, evidence repository, test cadence). Structural and consistency validation only: a valid record proves neither that a control works nor that anyone adopted or approved it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "record_status",
    "control_id",
    "control_name",
    "description",
    "risk",
    "accountable_owner",
    "implementation_owner",
    "enforcement_location",
    "implementation",
    "test_method",
    "test_frequency",
    "evidence_repository",
    "last_tested",
    "result",
    "effectiveness_status",
    "exceptions",
    "remediation",
    "next_review",
    "boundary"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "record_type": {
      "const": "control_register_entry"
    },
    "schema_version": {
      "const": "1.0"
    },
    "record_status": {
      "enum": [
        "draft",
        "final",
        "example"
      ],
      "description": "'example' records are rejected unless --allow-examples is passed."
    },
    "control_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z][A-Z0-9]*)*-[0-9]{3}$"
    },
    "control_name": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 3
    },
    "risk": {
      "type": "string",
      "minLength": 3
    },
    "accountable_owner": {
      "$ref": "#/$defs/person"
    },
    "implementation_owner": {
      "$ref": "#/$defs/person"
    },
    "enforcement_location": {
      "type": "string",
      "minLength": 3
    },
    "implementation": {
      "type": "string",
      "minLength": 3
    },
    "test_method": {
      "type": "string",
      "minLength": 3
    },
    "test_frequency": {
      "enum": [
        "per_change",
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "annually",
        "event_driven"
      ]
    },
    "evidence_repository": {
      "$ref": "#/$defs/ref"
    },
    "last_tested": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_evidence_ref": {
      "$ref": "#/$defs/ref"
    },
    "result": {
      "enum": [
        "Pass",
        "Fail",
        "Partial",
        "Not tested"
      ]
    },
    "effectiveness_status": {
      "enum": [
        "effective",
        "partially_effective",
        "ineffective",
        "not_assessed"
      ]
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "remediation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "action",
            "owner",
            "due_date"
          ],
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "minLength": 3
            },
            "owner": {
              "$ref": "#/$defs/person"
            },
            "due_date": {
              "$ref": "#/$defs/date"
            }
          }
        }
      ]
    },
    "next_review": {
      "$ref": "#/$defs/date"
    },
    "boundary": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "A toolkit-tested, B toolkit template, C enterprise infra/owner, D legal/regulatory/executive."
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "description": "A named individual and their governance role. Placeholders are rejected by the validator.",
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "role": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ref": {
      "type": "string",
      "minLength": 3,
      "description": "Evidence location: repo path, URL or record id."
    },
    "exception": {
      "type": "object",
      "description": "Authorized, time-bound risk acceptance or waiver.",
      "required": [
        "waiver_id",
        "approved_by",
        "expires",
        "risk_accepted"
      ],
      "additionalProperties": false,
      "properties": {
        "waiver_id": {
          "type": "string",
          "minLength": 3
        },
        "approved_by": {
          "$ref": "#/$defs/person"
        },
        "expires": {
          "$ref": "#/$defs/date"
        },
        "risk_accepted": {
          "type": "string",
          "minLength": 3
        }
      }
    }
  }
}
