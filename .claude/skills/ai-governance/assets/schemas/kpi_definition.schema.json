{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governance scorecard KPI definition",
  "description": "Definition and latest measurement of one scorecard KPI. Source: ai-governance skill, governance section 17. Boundary B (template) / C (instrumentation owner and data source). Structural and consistency validation only: a valid record proves neither that a control works nor that anyone adopted or approved it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "record_status",
    "kpi_id",
    "domain",
    "name",
    "numerator",
    "denominator",
    "measurement_window",
    "data_source",
    "instrumentation_owner",
    "target_threshold",
    "escalation_threshold",
    "last_measurement_date"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "record_type": {
      "const": "kpi_definition"
    },
    "schema_version": {
      "const": "1.0"
    },
    "record_status": {
      "enum": [
        "draft",
        "final",
        "example"
      ],
      "description": "'example' records are rejected unless --allow-examples is passed."
    },
    "kpi_id": {
      "type": "string",
      "minLength": 3
    },
    "domain": {
      "enum": [
        "Discovery",
        "Shadow AI",
        "Risk",
        "Ownership",
        "Control Testing",
        "Security",
        "Data Privacy",
        "Model Quality",
        "Evaluations",
        "Canary Hygiene",
        "Agent Autonomy",
        "Agent Recovery",
        "Human Oversight",
        "Supply Chain",
        "Policy Engine",
        "SRE",
        "FinOps",
        "Vendor",
        "Developer Experience",
        "Governance",
        "Business Value"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "numerator": {
      "type": "string",
      "minLength": 3
    },
    "denominator": {
      "type": "string",
      "minLength": 3
    },
    "measurement_window": {
      "type": "string",
      "minLength": 3
    },
    "data_source": {
      "type": "string",
      "minLength": 3
    },
    "instrumentation_owner": {
      "$ref": "#/$defs/person"
    },
    "target_threshold": {
      "type": "string",
      "minLength": 1
    },
    "escalation_threshold": {
      "type": "string",
      "minLength": 1
    },
    "last_measurement_date": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_value": {
      "type": "number"
    },
    "counts_violations_or_blocks": {
      "type": "boolean"
    },
    "independent_control_test_ref": {
      "$ref": "#/$defs/ref"
    },
    "detection_coverage_ref": {
      "$ref": "#/$defs/ref"
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "description": "A named individual and their governance role. Placeholders are rejected by the validator.",
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "role": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ref": {
      "type": "string",
      "minLength": 3,
      "description": "Evidence location: repo path, URL or record id."
    }
  }
}
