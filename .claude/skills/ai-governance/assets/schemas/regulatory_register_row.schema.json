{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dated regulatory register row",
  "description": "One obligation in the living regulatory register. Source: ai-governance skill, governance sections 2.13, 15.1, 15.2. Boundary D (legal applicability and interpretation) / B (template). Structural and consistency validation only: a valid record proves neither that a control works nor that anyone adopted or approved it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "record_status",
    "row_id",
    "jurisdiction",
    "regulation",
    "article",
    "role",
    "affected_systems",
    "effective_date",
    "date_legal_status",
    "treated_as_binding",
    "source_url",
    "compliance_owner",
    "business_owner",
    "technical_owner",
    "required_controls",
    "evidence_links",
    "compliance_status",
    "last_verification",
    "verified_by",
    "next_review",
    "change_trigger"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "record_type": {
      "const": "regulatory_register_row"
    },
    "schema_version": {
      "const": "1.0"
    },
    "record_status": {
      "enum": [
        "draft",
        "final",
        "example"
      ],
      "description": "'example' records are rejected unless --allow-examples is passed."
    },
    "row_id": {
      "type": "string",
      "minLength": 3
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2
    },
    "regulation": {
      "type": "string",
      "minLength": 3
    },
    "article": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "provider",
        "deployer",
        "importer",
        "distributor",
        "product_manufacturer",
        "not_applicable",
        "undetermined"
      ]
    },
    "affected_systems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "minItems": 1
    },
    "effective_date": {
      "$ref": "#/$defs/date"
    },
    "date_legal_status": {
      "enum": [
        "enacted",
        "proposed",
        "guidance",
        "unverified"
      ]
    },
    "treated_as_binding": {
      "type": "boolean"
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "compliance_owner": {
      "$ref": "#/$defs/person"
    },
    "business_owner": {
      "$ref": "#/$defs/person"
    },
    "technical_owner": {
      "$ref": "#/$defs/person"
    },
    "required_controls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "compliance_status": {
      "enum": [
        "compliant",
        "partially_compliant",
        "non_compliant",
        "not_applicable",
        "not_assessed"
      ]
    },
    "last_verification": {
      "$ref": "#/$defs/date"
    },
    "verified_by": {
      "$ref": "#/$defs/person"
    },
    "next_review": {
      "$ref": "#/$defs/date"
    },
    "change_trigger": {
      "type": "string",
      "minLength": 3
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "description": "A named individual and their governance role. Placeholders are rejected by the validator.",
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "role": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ref": {
      "type": "string",
      "minLength": 3,
      "description": "Evidence location: repo path, URL or record id."
    }
  }
}
