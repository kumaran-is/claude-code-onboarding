{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r1_routing.schema.json",
  "title": "R1 path routing (changed path globs -> suites; PRs touching several paths run the union)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "always", "rules", "never_on_pr"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "always": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true,
               "description": "Suites every AI PR runs (critical security/compliance/isolation cases are never sampled out)."},
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "paths", "suites"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "suites": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "never_sampled": {"type": "boolean"}
        }
      }
    },
    "never_on_pr": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true,
                    "description": "Suites that must never be routed into R1 (nightly / release only)."}
  }
}
