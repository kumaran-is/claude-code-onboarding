{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redteam_case.schema.json",
  "title": "Red-team case file (YAML: {cases: [...]})",
  "description": "Every case maps to exactly one threat-model attack class. sub_class adds the common industry label (OWASP LLM / API) without replacing the class.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "attack_class",
        "feature",
        "risk_level",
        "tiers",
        "input",
        "expected",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*-[0-9]{3,}$"
        },
        "attack_class": {
          "enum": [
            "cross_scope_exfiltration",
            "direct_prompt_injection",
            "indirect_injection_retrieved",
            "indirect_injection_stored",
            "multi_turn_escalation",
            "tool_poisoning_unsafe_call",
            "compliance_bypass_paraphrase",
            "structured_output_abuse",
            "mis_routing",
            "mass_action_abuse",
            "voice_ocr_file_injection",
            "embedding_poisoning",
            "vector_membership_inference",
            "cost_dos_amplification",
            "jailbreak",
            "system_prompt_leakage",
            "supply_chain",
            "insecure_output_handling",
            "sensitive_information_disclosure",
            "misinformation_overreliance",
            "model_extraction"
          ]
        },
        "ac_id": {
          "type": "string",
          "pattern": "^AC-(0[1-9]|1[0-8])$",
          "description": "Primary attack class in the security playbook catalogue (exactly one)."
        },
        "secondary_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^AC-(0[1-9]|1[0-8])$"
          }
        },
        "owasp_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(LLM(0[1-9]|10):2025|ASI(0[1-9]|10))$"
          }
        },
        "atlas_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^AML\\.TA?[0-9]{4}(\\.[0-9]{3})?$"
          }
        },
        "source": {
          "type": "string",
          "pattern": "^(expert_authored|finding:[A-Za-z0-9._-]+|incident:INC-[0-9]{4}-[0-9]{3,}|external_exercise:[A-Za-z0-9._-]+)$",
          "description": "A case from a finding or incident is never deleted (validator GD021)."
        },
        "asr_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runs",
            "max_successes"
          ],
          "properties": {
            "runs": {
              "type": "integer",
              "minimum": 1
            },
            "max_successes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "paraphrase_of": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*-[0-9]{3,}$",
          "description": "Id of the critical case this phrasing belongs to."
        },
        "sub_class": {
          "enum": [
            "bola",
            "bfla",
            "cross_tenant",
            "pii_leakage",
            "excessive_agency",
            "unauthorized_tool_access",
            "rag_poisoning",
            "tool_description_poisoning",
            "workflow_manipulation",
            "jailbreak",
            "memory_poisoning"
          ]
        },
        "feature": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "target_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "risk_level": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "R1",
              "R2",
              "R3",
              "R4"
            ]
          }
        },
        "blocker": {
          "enum": [
            "cross_scope_access",
            "injection_tool_call",
            "compliance_bypass_unflagged",
            "tool_accepts_cross_scope_id",
            "unauthorized_tool_call_succeeds",
            "rag_cross_scope_retrieval",
            "structured_output_schema_failure",
            "write_tool_without_audit",
            "zero_mapped_cases",
            "model_supplied_scope_accepted",
            "rag_cross_scope_count_or_neighbor",
            "unencoded_output_to_sink",
            "system_prompt_canary_in_output"
          ]
        },
        "input": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "user_message"
              ],
              "properties": {
                "user_message": {
                  "type": "string",
                  "minLength": 1
                },
                "planted_content": {
                  "type": "string"
                },
                "caller": {
                  "$ref": "#/$defs/caller"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "turns"
              ],
              "properties": {
                "turns": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "planted_content": {
                  "type": "string"
                },
                "caller": {
                  "$ref": "#/$defs/caller"
                }
              }
            }
          ]
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "refuse",
                "no_tool_call",
                "blocked_by_control",
                "flagged_for_review",
                "schema_reject",
                "bounded"
              ]
            },
            "forbidden_tools": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "forbidden_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 0
            },
            "output_must_not_contain": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Canary tokens, other-scope markers."
            },
            "authz_result": {
              "enum": [
                "FORBIDDEN",
                "ALLOWED"
              ]
            }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "risk_level": {
                "const": "critical"
              }
            },
            "required": [
              "risk_level"
            ]
          },
          "then": {
            "properties": {
              "tiers": {
                "contains": {
                  "const": "R1"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk_level": {
                "const": "critical"
              }
            },
            "required": [
              "risk_level",
              "asr_budget"
            ]
          },
          "then": {
            "properties": {
              "asr_budget": {
                "properties": {
                  "max_successes": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "scope_id"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "scope_id": {
          "type": "string"
        }
      }
    }
  }
}
