                },
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
                }
              ]
            },
            "message": {
              "allOf": [
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "maxLength": 500
                  }
                }
              ]
            }
          },
          "required": [
            "component",
            "label",
            "status"
          ]
        }
      ],
      "unevaluatedProperties": false,
      "x-genui": {
        "schemaVersion": 1,
        "allowedActions": [],
        "dataBinding": {
          "status": "literal or JSON Pointer to one of the status enum values; any other bound value renders as 'unknown'"
        },
        "a11y": {
          "role": "status (polite live region); status is conveyed as text, never colour only",
          "labelSource": "label"
        },
        "fallback": "render-text-label"
      }
    },
    "InputForm": {
      "type": "object",
      "description": "An editable form; each field writes to its bound data-model path; submit sends the resolved values.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "InputForm"
            },
            "title": {
              "allOf": [
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "maxLength": 200
                  }
                }
              ]
            },
            "formId": {
              "type": "string",
