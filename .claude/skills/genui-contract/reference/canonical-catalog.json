{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalogs.example.com/genui/canonical/v1/catalog.json",
  "title": "Canonical GenUI Catalog",
  "description": "Framework-neutral A2UI v0.9 catalog of eight business components. Platforms map each component name to their own component or widget.",
  "catalogId": "https://catalogs.example.com/genui/canonical/v1/catalog.json",
  "x-genui": {
    "contractVersion": "1.0.0",
    "protocolVersion": "v0.9",
    "acceptedWireVersions": [
      "v0.9"
    ],
    "platforms": [
      "angular",
      "react",
      "flutter"
    ],
    "limits": {
      "maxMessageBytes": 262144,
      "maxComponentsPerSurface": 200,
      "maxDepth": 8,
      "maxStringLength": 10000
    },
    "forbiddenStringPatterns": [
      "(?i)^\\s*javascript:",
      "(?i)^\\s*vbscript:",
      "(?i)^\\s*data:text/html",
      "(?i)<\\s*script"
    ],
    "actionTransport": {
      "idempotencyKey": "The client adapter generates one UUIDv4 per user intent for actions with requiresIdempotencyKey and sends it beside the A2UI message (e.g. an Idempotency-Key header or transport metadata), never inside action.context.",
      "authorization": "Every action is authorised server-side from the authenticated session; nothing in context grants permission."
    },
    "actions": {
      "item.open": {
        "description": "Open the referenced item in the host app (navigation only).",
        "sideEffect": false,
        "risk": "low",
        "requiresIdempotencyKey": false,
        "requiresHumanApproval": false,
        "payloadSchema": {
          "type": "object",
          "properties": {
            "itemId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "itemId"
          ],
          "additionalProperties": false
        }
      },
      "item.dismiss": {
        "description": "Dismiss a suggested item for this user.",
        "sideEffect": true,
        "risk": "low",
        "requiresIdempotencyKey": true,
        "requiresHumanApproval": false,
        "payloadSchema": {
          "type": "object",
          "properties": {
            "itemId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "itemId"
          ],
          "additionalProperties": false
        }
      },
      "approval.approve": {
        "description": "Approve a pending request. The server re-checks that the caller may approve requestId.",
        "sideEffect": true,
        "risk": "high",
        "requiresIdempotencyKey": true,
        "requiresHumanApproval": true,
        "payloadSchema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "comment": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "requestId"
          ],
          "additionalProperties": false
        }
      },
      "approval.reject": {
        "description": "Reject a pending request with a reason.",
        "sideEffect": true,
        "risk": "high",
        "requiresIdempotencyKey": true,
        "requiresHumanApproval": true,
        "payloadSchema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "requestId",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "selection.submit": {
        "description": "Submit the ids the user selected from a SelectionList.",
        "sideEffect": true,
        "risk": "medium",
        "requiresIdempotencyKey": true,
        "requiresHumanApproval": false,
        "payloadSchema": {
          "type": "object",
          "properties": {
            "listId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "selectedIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true
            }
          },
          "required": [
            "listId",
            "selectedIds"
          ],
          "additionalProperties": false
        }
      },
      "form.submit": {
        "description": "Submit InputForm values. Keys are the form's field names; the server validates each value again.",
        "sideEffect": true,
        "risk": "medium",
        "requiresIdempotencyKey": true,
        "requiresHumanApproval": false,
        "payloadSchema": {
          "type": "object",
          "properties": {
            "formId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "values": {
              "type": "object",
              "maxProperties": 20,
              "propertyNames": {
                "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "integer",
                  "boolean"
                ],
                "maxLength": 10000
              }
            }
          },
          "required": [
            "formId",
            "values"
          ],
          "additionalProperties": false
        }
      },
      "form.cancel": {
        "description": "The user abandoned the form. No data is sent.",
        "sideEffect": false,
        "risk": "low",
        "requiresIdempotencyKey": false,
        "requiresHumanApproval": false,
        "payloadSchema": {
          "type": "object",
          "properties": {
            "formId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "formId"
          ],
          "additionalProperties": false
        }
      },
      "dialog.confirm": {
        "description": "The user confirmed the operation the dialog describes. The server executes the operation it stored under dialogId, never one named in the payload.",
        "sideEffect": true,
        "risk": "high",
        "requiresIdempotencyKey": true,
        "requiresHumanApproval": true,
        "payloadSchema": {
          "type": "object",
          "properties": {
            "dialogId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "dialogId"
          ],
          "additionalProperties": false
        }
      },
      "dialog.cancel": {
        "description": "The user dismissed the dialog.",
        "sideEffect": false,
        "risk": "low",
        "requiresIdempotencyKey": false,
        "requiresHumanApproval": false,
        "payloadSchema": {
          "type": "object",
          "properties": {
            "dialogId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "dialogId"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "components": {
    "ActionCard": {
      "type": "object",
      "description": "A titled card with a short body and up to three action buttons.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "ActionCard"
            },
            "title": {
              "allOf": [
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "maxLength": 200
                  }
                }
              ]
            },
            "subtitle": {
              "allOf": [
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "maxLength": 200
                  }
                }
              ]
            },
            "body": {
              "allOf": [
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "maxLength": 2000
                  }
                }
              ]
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "variant": {
                    "enum": [
                      "primary",
                      "secondary"
                    ]
                  },
                  "action": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/ServerEvent"
                      },
                      {
                        "properties": {
                          "event": {
                            "properties": {
                              "name": {
                                "enum": [
                                  "item.open",
                                  "item.dismiss"
                                ]
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "label",
                  "action"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "component",
            "title"
          ]
        }
      ],
      "unevaluatedProperties": false,
      "x-genui": {
        "schemaVersion": 1,
        "allowedActions": [
          "item.open",
          "item.dismiss"
        ],
        "a11y": {
          "role": "article (web) / container semantics (Flutter); each action is a button",
          "labelSource": "accessibility.label, else title",
          "buttonLabelSource": "actions[].label"
        },
        "fallback": "render-error-placeholder"
      }
    },
    "DataSummaryTable": {
      "type": "object",
      "description": "A read-only table of rows bound from the data model. Cells render as plain text, never HTML.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "DataSummaryTable"
            },
            "caption": {
              "allOf": [
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "maxLength": 200
                  }
                }
              ]
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
                  },
                  "header": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "format": {
                    "enum": [
                      "text",
                      "integer",
                      "decimal",
                      "date",
                      "status"
                    ]
                  }
                },
                "required": [
                  "key",
                  "header"
                ],
                "additionalProperties": false
              }
            },
            "rows": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
            },
            "maxRows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": [
            "component",
            "caption",
            "columns",
            "rows"
          ]
        }
      ],
      "unevaluatedProperties": false,
      "x-genui": {
        "schemaVersion": 1,
        "allowedActions": [],
        "dataBinding": {
          "rows": "JSON Pointer to an array of flat objects keyed by columns[].key; rows beyond maxRows (default 50) are not rendered and a 'showing N of M' note is shown"
        },
        "a11y": {
          "role": "table with caption and column headers (web <table>/<th scope=col>; Flutter Table inside Semantics)",
          "labelSource": "caption"
        },
        "fallback": "render-error-placeholder"
      }
    },
    "ApprovalForm": {
      "type": "object",
      "description": "Shows a pending request and lets a human approve or reject it with an optional comment.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "ApprovalForm"
            },
            "title": {
              "allOf": [
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "maxLength": 200
                  }
                }
              ]
            },
            "summary": {
              "allOf": [
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "maxLength": 4000
                  }
                }
              ]
            },
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "riskLevel": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "comment": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
            },
            "approveAction": {
              "allOf": [
                {
                  "$ref": "#/$defs/ServerEvent"
                },
                {
                  "properties": {
                    "event": {
                      "properties": {
                        "name": {
                          "enum": [
                            "approval.approve"
                          ]
                        }
                      }
                    }
                  }
                }
              ]
            },
            "rejectAction": {
              "allOf": [
                {
                  "$ref": "#/$defs/ServerEvent"
                },
                {
                  "properties": {
                    "event": {
                      "properties": {
                        "name": {
                          "enum": [
                            "approval.reject"
                          ]
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "component",
            "title",
            "summary",
            "requestId",
            "riskLevel",
            "approveAction",
            "rejectAction"
          ]
        }
      ],
      "unevaluatedProperties": false,
      "x-genui": {
        "schemaVersion": 1,
        "allowedActions": [
          "approval.approve",
          "approval.reject"
        ],
        "dataBinding": {
          "comment": "two-way: the comment text field writes the user's text to this JSON Pointer"
        },
        "a11y": {
          "role": "form (web) / Semantics container (Flutter) with a labelled comment field and two buttons",
          "labelSource": "accessibility.label, else title",
          "riskAnnouncement": "riskLevel is shown as text, not colour only"
        },
        "fallback": "reject-surface"
      }
    },
    "SelectionList": {
      "type": "object",
      "description": "A single- or multi-select list of options; the selection is written to the data model.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "SelectionList"
            },
            "label": {
              "allOf": [
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "maxLength": 200
                  }
                }
              ]
            },
            "listId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "options": {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50,
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 300
                      }
                    },
                    "required": [
                      "id",
                      "label"
                    ],
                    "additionalProperties": false
                  }
                },
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
                }
              ]
            },
            "selected": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
            },
            "selectionMode": {
              "enum": [
                "single",
                "multiple"
              ]
            },
            "maxSelected": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "submitAction": {
              "allOf": [
                {
                  "$ref": "#/$defs/ServerEvent"
                },
                {
                  "properties": {
                    "event": {
                      "properties": {
                        "name": {
                          "enum": [
                            "selection.submit"
                          ]
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "component",
            "label",
            "listId",
            "options",
            "selected",
            "selectionMode"
          ]
        }
      ],
      "unevaluatedProperties": false,
      "x-genui": {
        "schemaVersion": 1,
        "allowedActions": [
          "selection.submit"
        ],
        "dataBinding": {
          "selected": "two-way: JSON Pointer to an array of selected option ids",
          "options": "literal array or JSON Pointer to an array of {id,label,description}"
        },
        "a11y": {
          "role": "radiogroup (single) or group of checkboxes (multiple)",
          "labelSource": "label"
        },
        "fallback": "render-error-placeholder"
      }
    },
    "DetailPanel": {
      "type": "object",
      "description": "A read-only label/value panel; the only container in the catalog (children are component ids).",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "DetailPanel"
            },
            "title": {
              "allOf": [
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "maxLength": 200
                  }
                }
              ]
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "value": {
                    "allOf": [
                      {
                        "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                      },
                      {
                        "if": {
                          "type": "string"
                        },
                        "then": {
                          "maxLength": 2000
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "children": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId"
              }
            }
          },
          "required": [
            "component",
            "title",
            "fields"
          ]
        }
      ],
      "unevaluatedProperties": false,
      "x-genui": {
        "schemaVersion": 1,
        "allowedActions": [],
        "a11y": {
          "role": "region with heading (web <section aria-labelledby>; Flutter Semantics(container) + header)",
          "labelSource": "title"
        },
        "fallback": "render-error-placeholder"
      }
    },
    "StatusIndicator": {
      "type": "object",
      "description": "Shows the state of a long-running operation as text plus an icon.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "StatusIndicator"
            },
            "label": {
              "allOf": [
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "maxLength": 120
                  }
                }
              ]
            },
            "status": {
              "oneOf": [
                {
                  "enum": [
                    "pending",
                    "in_progress",
                    "succeeded",
                    "failed",
                    "cancelled",
