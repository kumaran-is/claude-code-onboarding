{
  "description": "ActionCard; v1.0: surface, components and data model in ONE createSurface message.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "card-1",
        "catalogId": "https://catalogs.example.com/genui/canonical-a2ui-1_0/v1/catalog.json",
        "components": [
          {
            "id": "root",
            "component": "ActionCard",
            "title": {
              "@path": "/card/title"
            },
            "subtitle": "Suggested next step",
            "body": {
              "@path": "/card/body"
            },
            "@accessibility": {
              "label": "Suggested booking"
            },
            "actions": [
              {
                "label": "Open booking",
                "variant": "primary",
                "action": {
                  "event": {
                    "name": "item.open",
                    "context": {
                      "itemId": "booking-1042"
                    }
                  }
                }
              },
              {
                "label": "Dismiss",
                "variant": "secondary",
                "action": {
                  "event": {
                    "name": "item.dismiss",
                    "context": {
                      "itemId": "booking-1042"
                    }
                  }
                }
              }
            ]
          }
        ],
        "dataModel": {
          "card": {
            "title": "Booking needs a time slot",
            "body": "Choose a slot before Friday."
          }
        }
      }
    }
  ]
}
