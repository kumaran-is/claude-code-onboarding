{
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "Strict TypeScript 5.9 for bundled apps and libraries (moduleResolution bundler). Node services run by node directly: use the nodenext config in node-service-engineering.md section 1. Angular/Vite solution layouts: see SKILL.md",
    "compilerOptions": {
        // =========================================================================
        // STRICTNESS (Maximum Type Safety)
        // =========================================================================
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "exactOptionalPropertyTypes": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "forceConsistentCasingInFileNames": true,
        // =========================================================================
        // MODULE SYSTEM (Modern ESM)
        // =========================================================================
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        // =========================================================================
        // OUTPUT
        // =========================================================================
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        // =========================================================================
        // PERFORMANCE
        // =========================================================================
        "skipLibCheck": true,
        "incremental": true,
        // =========================================================================
        // PATH ALIASES
        // =========================================================================
        // `paths` resolve relative to this file; `baseUrl` is not needed (and is deprecated from TypeScript 6).
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@/components/*": [
                "./src/components/*"
            ],
            "@/lib/*": [
                "./src/lib/*"
            ],
            "@/types/*": [
                "./src/types/*"
            ],
            "@/utils/*": [
                "./src/utils/*"
            ]
        },
        // =========================================================================
        // JSX (for React projects)
        // =========================================================================
        // "jsx": "react-jsx",
        // "types": ["vite/client"],   // Vite: import.meta.env and asset imports
        // =========================================================================
        // EMIT
        // =========================================================================
        "noEmit": true, // Let bundler handle emit
        // Library that emits: remove noEmit, add "declaration": true, "declarationMap": true, "outDir": "./dist"
        // =========================================================================
        // DECORATORS (if needed)
        // =========================================================================
        // "experimentalDecorators": true,
        // "emitDecoratorMetadata": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "build",
        "coverage",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
    ]
}
